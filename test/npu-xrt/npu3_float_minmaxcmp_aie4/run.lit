//
// Check FP32 NaN propagation, minnum/maxnum numeric fallback, ordered
// comparisons, and signed zeros on NPU3 using the integer-based lowering.
//
// test.cpp seeds NaNs in DMA inputs to avoid NaN literal parsing differences
// between the host LLVM and Peano versions.
//
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: %run_on_npu3% python %S/float_minmaxcmp_aie4.py -o float_minmaxcmp_aie4.mlir
// RUN: %aiecc --enable-aie4-vectorization --get-full-elf --full-elf-name=float_minmaxcmp_aie4.elf float_minmaxcmp_aie4.mlir
//
// Check instruction mnemonics: llc can accept an unknown intrinsic name as an
// external call, so successful compilation alone does not verify the lowering.
// RUN: llvm-objdump -dr float_minmaxcmp_aie4.mlir.prj/elfs_main_core_0_2/elfs_main_core_0_2.elf > dis.txt
// RUN: FileCheck %s --check-prefix=MNEMONIC --input-file=dis.txt --implicit-check-not=vge.fp32 --implicit-check-not=vlt.fp32 --implicit-check-not=vmin_ge.fp32 --implicit-check-not=vmax_lt.fp32
//
// Integer comparisons and selects implement the IEEE encoding order.
// MNEMONIC-DAG: vlt.32
// MNEMONIC-DAG: vsel.32
//
// Run the kernel and check the numerical results in test.cpp.
// RUN: clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++ %test_utils_flags
// RUN: %run_on_npu3% ./test.exe
