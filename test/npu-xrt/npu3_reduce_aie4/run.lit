//
// Check source add semantics against explicit native VADDR/VADDR.f and
// verify that signed and floating min/max use native instructions.
//
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: %run_on_npu3% python %S/reduce_aie4.py -o reduce_aie4.mlir
// RUN: %aiecc --enable-aie4-vectorization --get-full-elf --full-elf-name=reduce_aie4.elf reduce_aie4.mlir
//
// Check actual mnemonics; linking alone can accept unresolved intrinsics.
// RUN: llvm-objdump -dr reduce_aie4.mlir.prj/elfs_main_core_0_2/elfs_main_core_0_2.elf > dis.txt
// RUN: FileCheck %s --check-prefix=MNEMONIC --input-file=dis.txt
//
// DAG checks allow scheduling to reorder reductions. Operand counts verify
// seeded integer add and unseeded min/max and floating add forms.
// MNEMONIC-DAG: vaddr{{[[:space:]]+r[0-9]+, y[0-9]+, r[0-9]+}}
// MNEMONIC-DAG: vminr{{[[:space:]]+r[0-9]+, y[0-9]+[[:blank:]]*$}}
// MNEMONIC-DAG: vmaxr{{[[:space:]]+r[0-9]+, y[0-9]+[[:blank:]]*$}}
// MNEMONIC-DAG: vaddr.f{{[[:space:]]+r[0-9]+, y[0-9]+[[:blank:]]*$}}
// MNEMONIC-DAG: vminr.f{{[[:space:]]+r[0-9]+, y[0-9]+[[:blank:]]*$}}
// MNEMONIC-DAG: vmaxr.f{{[[:space:]]+r[0-9]+, y[0-9]+[[:blank:]]*$}}
//
// RUN: clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++ %test_utils_flags
// RUN: %run_on_npu3% ./test.exe
