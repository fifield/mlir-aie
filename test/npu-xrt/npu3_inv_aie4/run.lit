//
// Accuracy and special values of afn 1.0 / x (scalar INV) on NPU3, and
// exactness of strict 1.0 / x (__divsf3).
//
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: %run_on_npu3% python %S/inv.py -o inv.mlir
// RUN: %aiecc -j 4 --enable-aie4-vectorization --get-full-elf --full-elf-name=inv.elf inv.mlir
//
// RUN: llvm-objdump -dr inv.mlir.prj/elfs_main_core_0_2/elfs_main_core_0_2.elf > dis.txt
// RUN: FileCheck %s --check-prefix=MNEMONIC --input-file=dis.txt
// MNEMONIC-DAG: {{[[:space:]]}}inv{{[[:space:]]+}}r{{[0-9]+}}, r{{[0-9]+}}
// MNEMONIC-DAG: R_AIE{{.*}}__divsf3
//
// RUN: clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++ -lm %test_utils_flags
// RUN: %run_on_npu3% ./test.exe
//
// test.cpp checks the 1 ULP bound for normal INV inputs and results,
// special values, and strict division against the host IEEE result.
