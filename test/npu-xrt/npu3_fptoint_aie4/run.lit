//
// Vector arith.fptosi / arith.fptoui on NPU3 must truncate toward zero.
// poison.o's main() sets crRnd to 12 (nearest even) before entering the core,
// so the results depend only on the core's own entry write of crRnd = 2; the
// core reads crRnd back. The inputs include halves and negative fractions,
// where nearest even and toward zero differ.
//
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: %PEANO_INSTALL_DIR/bin/clang --target=aie4-none-unknown-elf -O2 -fstack-size-section -c %S/poison.c -o poison.o
// RUN: %run_on_npu3% python %S/fptoint.py -o fptoint.mlir
// RUN: %aiecc --enable-aie4-vectorization --get-full-elf --full-elf-name=fptoint.elf fptoint.mlir
// RUN: llvm-objdump -dr --no-show-raw-insn fptoint.mlir.prj/elfs_main_core_0_2/elfs_main_core_0_2.elf | FileCheck %s
// CHECK-LABEL: <core_0_2>:
// CHECK:       movx crrnd, #0x2
// CHECK-LABEL: <main>:
// CHECK:       movx crrnd, #0xc
//
// RUN: clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++ -lm %test_utils_flags
// RUN: %run_on_npu3% ./test.exe
