//
// Explicit shift-17 UPS with the fixture in nonsaturating mode.
//
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: %run_on_npu3% python %S/ups_shift.py -o ups_shift.mlir
// RUN: %aiecc -j 4 --enable-aie4-vectorization --get-full-elf --full-elf-name=ups_shift.elf ups_shift.mlir
//
// Confirm native instruction selection.
// RUN: llvm-objdump -dr ups_shift.mlir.prj/elfs_main_core_0_2/elfs_main_core_0_2.elf | FileCheck %s --check-prefix=VUPS
// VUPS: {{(v)?ups}}
//
// RUN: clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++ %test_utils_flags
// RUN: %run_on_npu3% ./test.exe
