//
// REQUIRES: ryzen_ai_npu3
//
// MEM-tile S2MM tasks across three columns emit actors 0, 1, 2, and 7. All four TCT
// routes terminate at shim (0,0), where the runtime job awaits them. Actor 7
// uses the upper bank's Control32:1 response port.
//
// RUN: rm -rf %t.d && mkdir -p %t.d
// RUN: cd %t.d
// RUN: aiecc --tmpdir=project --get-full-elf --full-elf-name=memtile_s2mm_tct.elf %S/memtile_s2mm_tct.mlir
// RUN: FileCheck %s --check-prefix=LOWERING < project/full_elf_cert.mlir.asm
// RUN: clang %S/test.cpp -o test.exe -std=c++17 -Wall %xrt_flags -lrt -lstdc++
// RUN: %run_on_npu3% ./test.exe 2>&1 | FileCheck %s --check-prefix=PASS
//
// LOWERING: WAIT_TCTS{{[[:space:]]+}}65, 7, 1
// LOWERING: WAIT_TCTS{{[[:space:]]+}}65, 2, 1
// LOWERING: WAIT_TCTS{{[[:space:]]+}}33, 1, 1
// LOWERING: WAIT_TCTS{{[[:space:]]+}}1, 0, 1
// PASS: PASS: MEM-tile S2MM actors 0, 1, 2, and 7 satisfied their WAIT_TCTS operations
