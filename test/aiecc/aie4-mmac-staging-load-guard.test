//
// Check the staging-load workaround on a reduced input and paired-column
// B loads in every dense format. Extraction and concatenation must fold
// back to a direct load to exercise the faulty combine: the integer IR
// checks require B1's load before B0's commit, feeding B1's insert.
//
// Each final schedule needs 96 inserts, 3 commits and 12 MMACs without
// interleaving or accumulator spills. Per-core flag scoping is covered by
// aie4-mmac-fp8-cse-guard.mlir; hardware checks are in npu3_mmac_aievec.
//
// REQUIRES: peano
//
// RUN: llc -O2 --mtriple=aie4 --mcpu=aie4b -aie4postlegalizercustomcombiner-disable-rule=combine_staging_upd_load -filetype=obj %S/Inputs/aie4_staging_load_hoist.ll -o %t.reduced.o
// RUN: llvm-objdump -d %t.reduced.o > %t.reduced.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.reduced.dis --inserts-per-tile 1 --mmacs-per-tile 1,1,1 | FileCheck %s --check-prefix=REDUCED
// REDUCED: ORDER OK: 3 tiles, 3 inserts, 3 MMACs, no accumulator spills
//
// RUN: %python %S/Inputs/aie4_mmac_design.py int8 --pair-b-loads -o %t.int8.mlir
// RUN: %aiecc -v --get-core-elfs --tmpdir %t.int8.prj --output-dir %t.int8.out %t.int8.mlir 2>&1 | FileCheck %s --check-prefix=GUARD
// RUN: FileCheck %s --check-prefix=IR --input-file %t.int8.prj/opted_main_core_0_2.ll
// RUN: llvm-objdump -d %t.int8.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.int8.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.int8.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
//
// RUN: %python %S/Inputs/aie4_mmac_design.py int4 --pair-b-loads -o %t.int4.mlir
// RUN: %aiecc -v --get-core-elfs --tmpdir %t.int4.prj --output-dir %t.int4.out %t.int4.mlir 2>&1 | FileCheck %s --check-prefix=GUARD
// RUN: FileCheck %s --check-prefix=IR --input-file %t.int4.prj/opted_main_core_0_2.ll
// RUN: llvm-objdump -d %t.int4.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.int4.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.int4.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
//
// RUN: %python %S/Inputs/aie4_mmac_design.py bf16 --pair-b-loads -o %t.bf16.mlir
// RUN: %aiecc -v --get-core-elfs --tmpdir %t.bf16.prj --output-dir %t.bf16.out %t.bf16.mlir 2>&1 | FileCheck %s --check-prefix=GUARD
// RUN: llvm-objdump -d %t.bf16.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.bf16.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.bf16.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
//
// RUN: %python %S/Inputs/aie4_mmac_design.py fp8 --pair-b-loads -o %t.fp8.mlir
// RUN: %aiecc -v --get-core-elfs --tmpdir %t.fp8.prj --output-dir %t.fp8.out %t.fp8.mlir 2>&1 | FileCheck %s --check-prefix=FP8-GUARD
// RUN: llvm-objdump -d %t.fp8.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.fp8.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.fp8.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
//
// GUARD: exec: {{.*}}/llc {{.*}}peano-opted_[[CORE:canonical_[0-9A-F_]+]].ll -O2 --march=aie4 --mcpu=aie4b -aie4postlegalizergenericcombiner-disable-rule=combine_indexed_to_autoinc -aie4postlegalizercustomcombiner-disable-rule=combine_staging_upd_load,combine_indexed_to_autoinc --function-sections
// GUARD: aiecc: main_core_0_2: {{.*}}/[[CORE]].o {{renamed to|recompiled as}} {{.*}}/objects_main_core_0_2.o
// FP8-GUARD: exec: {{.*}}/llc {{.*}}peano-opted_[[CORE:canonical_[0-9A-F_]+]].ll -O2 --march=aie4 --mcpu=aie4b -disable-machine-cse -aie4postlegalizergenericcombiner-disable-rule=combine_indexed_to_autoinc -aie4postlegalizercustomcombiner-disable-rule=combine_staging_upd_load,combine_indexed_to_autoinc --function-sections
// FP8-GUARD: aiecc: main_core_0_2: {{.*}}/[[CORE]].o {{renamed to|recompiled as}} {{.*}}/objects_main_core_0_2.o
// IR: %[[B1:[0-9]+]] = load <128 x i8>, ptr getelementptr {{.*}} @in0__cons__buf0, i20 4608)
// IR: call void @llvm.aie4.staging.to.matrix.{{(I4.)?}}I32768()
// IR: call void @llvm.aie4.insert.staging.int.I1024(<128 x i8> %[[B1]], i32 0, i32 {{[13]}})
// ORDER: ORDER OK: 3 tiles, 96 inserts, 12 MMACs, no accumulator spills
