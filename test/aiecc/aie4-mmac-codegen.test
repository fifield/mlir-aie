//
// Compile each dense format and check insert/commit/MMAC order in LLVM IR
// and disassembly, with no accumulator spills. The schedule checker models
// register access timing because issue order alone does not determine it.
// Inputs/aie4_mmac_design.py stages B0, B1, then B<r3>; the last MMACs set
// zero_acc.
//
// REQUIRES: peano

// RUN: %python %S/Inputs/aie4_mmac_design.py bf16 --r3-tile 0 -o %t.bf16.mlir
// RUN: %aiecc --get-core-elfs --tmpdir %t.bf16.prj --output-dir %t.bf16.out %t.bf16.mlir
// RUN: FileCheck %s --check-prefix=BF16-IR --input-file %t.bf16.prj/opted_main_core_0_2.ll
// RUN: llvm-objdump -d %t.bf16.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.bf16.dis
// RUN: FileCheck %s --check-prefix=BF16-ASM --input-file %t.bf16.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.bf16.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
// RUN: %python %S/Inputs/aie4_mmac_design.py int8 --r3-tile 0 -o %t.int8.mlir
// RUN: %aiecc --get-core-elfs --tmpdir %t.int8.prj --output-dir %t.int8.out %t.int8.mlir
// RUN: FileCheck %s --check-prefix=INT8-IR --input-file %t.int8.prj/opted_main_core_0_2.ll
// RUN: llvm-objdump -d %t.int8.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.int8.dis
// RUN: FileCheck %s --check-prefix=INT8-ASM --input-file %t.int8.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.int8.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
// RUN: %python %S/Inputs/aie4_mmac_design.py int4 --r3-tile 0 -o %t.int4.mlir
// RUN: %aiecc --get-core-elfs --tmpdir %t.int4.prj --output-dir %t.int4.out %t.int4.mlir
// RUN: FileCheck %s --check-prefix=INT4-IR --input-file %t.int4.prj/opted_main_core_0_2.ll
// RUN: llvm-objdump -d %t.int4.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.int4.dis
// RUN: FileCheck %s --check-prefix=INT4-ASM --input-file %t.int4.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.int4.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
// RUN: %python %S/Inputs/aie4_mmac_design.py fp8 --r3-tile 0 -o %t.fp8.mlir
// RUN: %aiecc --get-core-elfs --tmpdir %t.fp8.prj --output-dir %t.fp8.out %t.fp8.mlir
// RUN: FileCheck %s --check-prefix=FP8-IR --input-file %t.fp8.prj/opted_main_core_0_2.ll
// RUN: llvm-objdump -d %t.fp8.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.fp8.dis
// RUN: FileCheck %s --check-prefix=FP8-ASM --implicit-check-not=crintmmode --input-file %t.fp8.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.fp8.dis --mmacs-per-tile 4,4,4 | FileCheck %s --check-prefix=ORDER
//
// ORDER: ORDER OK: 3 tiles, 96 inserts, 12 MMACs, no accumulator spills
//
// The maximum supported M reaches Peano and emits all 64 row MMACs.
// Register pressure may require spills at this boundary.
// RUN: %python %S/Inputs/aie4_mmac_kloop.py --m 64 --k-tiles 1 -o %t.m64.mlir
// RUN: %aiecc --no-measure-stack-size --get-core-elfs --tmpdir %t.m64.prj --output-dir %t.m64.out %t.m64.mlir
// RUN: llvm-objdump -d %t.m64.out/elfs_main_core_0_2/elfs_main_core_0_2.elf | FileCheck %s --check-prefix=M64 --implicit-check-not=llvm.aie4
// M64-LABEL: <main>:
// M64-NOT: jl
// M64-COUNT-64: mmac.f
// M64-NOT: mmac.f
// M64-NOT: jl
//
// The region inside an scf.for K loop: staging and the commit stay in the
// loop body, and order holds across the back edge (the checker runs the
// body twice, with a jump's delay slots or none for a zero-overhead loop).
// RUN: %python %S/Inputs/aie4_mmac_kloop.py -o %t.kloop.mlir
// RUN: %aiecc --get-core-elfs --tmpdir %t.kloop.prj --output-dir %t.kloop.out %t.kloop.mlir
// RUN: llvm-objdump -d %t.kloop.out/elfs_main_core_0_2/elfs_main_core_0_2.elf > %t.kloop.dis
// RUN: %python %S/aie4-mmac-schedule-checker.py %t.kloop.dis --mmacs-per-tile 4,4 | FileCheck %s --check-prefix=KLOOP
// RUN: FileCheck %s --check-prefix=KLOOP-ASM --input-file %t.kloop.dis
// KLOOP: ORDER OK: 2 tiles, 64 inserts, 8 MMACs, no accumulator spills (loop body checked twice)
// Accept either a conditional loop or a zero-overhead loop (ls/le/lc).
// KLOOP-ASM-DAG: <.LBB0_{{[0-9]+}}>:
// KLOOP-ASM-DAG: {{jnz[[:blank:]]+r[0-9]+, #0x|movxm[[:blank:]]+ls, #0x}}

// Reduced regression for the K-loop address corruption: Peano must retain
// the PHI's k + 1, not reuse a staging post-increment of constant index 1.
// Check after both passes that can perform the faulty combine.
// RUN: llc -O2 --mtriple=aie4 --mcpu=aie4b -aie4postlegalizergenericcombiner-disable-rule=combine_indexed_to_autoinc -aie4postlegalizercustomcombiner-disable-rule=combine_staging_upd_load,combine_indexed_to_autoinc -print-after=aie-postlegalizer-generic-combiner -print-after=aie-postlegalizer-custom-combiner %S/Inputs/aie4_staging_loop_increment.ll -o %t.increment.s 2>&1 | FileCheck %s --check-prefix=INCREMENT --implicit-check-not=G_AIE_INSERT_STAGING_AUTOINC
// INCREMENT-LABEL: IR Dump After AIE Post Legalizer Generic Combiner
// INCREMENT: %[[ONE:[0-9]+]]:_(s32) = G_CONSTANT i32 1
// INCREMENT: %[[K:[0-9]+]]:_(s32) = G_PHI {{.*}} %[[NEXT:[0-9]+]]:_(s32),
// INCREMENT: %[[NEXT]]:_(s32) = nuw nsw G_ADD %[[K]]:_, %[[ONE]]:_
// INCREMENT-LABEL: IR Dump After AIE Post Legalizer Custom Combiner
// INCREMENT: %[[ONE2:[0-9]+]]:_(s32) = G_CONSTANT i32 1
// INCREMENT: %[[K2:[0-9]+]]:_(s32) = G_PHI {{.*}} %[[NEXT2:[0-9]+]]:_(s32),
// INCREMENT: %[[NEXT2]]:_(s32) = nuw nsw G_ADD %[[K2]]:_, %[[ONE2]]:_

// BF16-IR-LABEL: define void @core_0_2(
// BF16-IR-COUNT-32: call void @llvm.aie4.insert.staging.bf16.I1024(
// BF16-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// BF16-IR: call void @llvm.aie4.staging.to.matrix.I32768()
// BF16-IR-NOT: llvm.aie4.insert.staging
// BF16-IR-COUNT-4: call <64 x float> @llvm.aie4.bf16.I512.ACC2048.mmac({{.*}}, i32 0)
// BF16-IR-NOT: llvm.aie4.{{.*}}mmac
// BF16-IR-COUNT-32: call void @llvm.aie4.insert.staging.bf16.I1024(
// BF16-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// BF16-IR: call void @llvm.aie4.staging.to.matrix.I32768()
// BF16-IR-NOT: llvm.aie4.insert.staging
// BF16-IR-COUNT-4: call <64 x float> @llvm.aie4.bf16.I512.ACC2048.mmac({{.*}}, i32 0)
// BF16-IR-NOT: llvm.aie4.{{.*}}mmac
// BF16-IR-COUNT-32: call void @llvm.aie4.insert.staging.bf16.I1024(
// BF16-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// BF16-IR: call void @llvm.aie4.staging.to.matrix.I32768()
// BF16-IR-NOT: llvm.aie4.insert.staging
// BF16-IR-COUNT-4: call <64 x float> @llvm.aie4.bf16.I512.ACC2048.mmac({{.*}}, i32 1)
// BF16-IR-NOT: llvm.aie4.{{.*}}mmac
// BF16-IR: ret void
// BF16-ASM-LABEL: <main>:
// BF16-ASM-DAG: movx{{[[:blank:]]+}}crintmmode, #0x2
// BF16-ASM-DAG: vmov{{[[:blank:]]+}}za[i{{[0-9]+}}], y{{[0-9]+}}
// BF16-ASM-DAG: vmov{{[[:blank:]]+}}zb, za{{[[:blank:]]*(;|$)}}
// BF16-ASM-DAG: mmac.f{{[[:blank:]]+}}dm{{[ab][0-9]+}}, dm{{[ab][0-9]+}}, x{{[0-9]+}}, zb, r{{[0-9]+}}

// INT8-IR-LABEL: define void @core_0_2(
// INT8-IR-COUNT-32: call void @llvm.aie4.insert.staging.int.I1024(
// INT8-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// INT8-IR: call void @llvm.aie4.staging.to.matrix.I32768()
// INT8-IR-NOT: llvm.aie4.insert.staging
// INT8-IR-COUNT-4: call <64 x i32> @llvm.aie4.I512.ACC2048.mmac({{.*}}, i32 264)
// INT8-IR-NOT: llvm.aie4.{{.*}}mmac
// INT8-IR-COUNT-32: call void @llvm.aie4.insert.staging.int.I1024(
// INT8-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// INT8-IR: call void @llvm.aie4.staging.to.matrix.I32768()
// INT8-IR-NOT: llvm.aie4.insert.staging
// INT8-IR-COUNT-4: call <64 x i32> @llvm.aie4.I512.ACC2048.mmac({{.*}}, i32 264)
// INT8-IR-NOT: llvm.aie4.{{.*}}mmac
// INT8-IR-COUNT-32: call void @llvm.aie4.insert.staging.int.I1024(
// INT8-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// INT8-IR: call void @llvm.aie4.staging.to.matrix.I32768()
// INT8-IR-NOT: llvm.aie4.insert.staging
// INT8-IR-COUNT-4: call <64 x i32> @llvm.aie4.I512.ACC2048.mmac({{.*}}, i32 265)
// INT8-IR-NOT: llvm.aie4.{{.*}}mmac
// INT8-IR: ret void
// INT8-ASM-LABEL: <main>:
// INT8-ASM-DAG: movx{{[[:blank:]]+}}crintmmode, #0x3
// INT8-ASM-DAG: vmov{{[[:blank:]]+}}za[i{{[0-9]+}}], y{{[0-9]+}}
// INT8-ASM-DAG: vmov{{[[:blank:]]+}}zb, za{{[[:blank:]]*(;|$)}}
// INT8-ASM-DAG: mmac.i{{[[:blank:]]+}}dm{{[ab][0-9]+}}, dm{{[ab][0-9]+}}, x{{[0-9]+}}, zb, r{{[0-9]+}}

// INT4-IR-LABEL: define void @core_0_2(
// INT4-IR-COUNT-32: call void @llvm.aie4.insert.staging.int.I1024(
// INT4-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// INT4-IR: call void @llvm.aie4.staging.to.matrix.I4.I32768()
// INT4-IR-NOT: llvm.aie4.insert.staging
// INT4-IR-COUNT-4: call <64 x i32> @llvm.aie4.I512.ACC2048.mmac({{.*}}, i32 768)
// INT4-IR-NOT: llvm.aie4.{{.*}}mmac
// INT4-IR-COUNT-32: call void @llvm.aie4.insert.staging.int.I1024(
// INT4-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// INT4-IR: call void @llvm.aie4.staging.to.matrix.I4.I32768()
// INT4-IR-NOT: llvm.aie4.insert.staging
// INT4-IR-COUNT-4: call <64 x i32> @llvm.aie4.I512.ACC2048.mmac({{.*}}, i32 768)
// INT4-IR-NOT: llvm.aie4.{{.*}}mmac
// INT4-IR-COUNT-32: call void @llvm.aie4.insert.staging.int.I1024(
// INT4-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// INT4-IR: call void @llvm.aie4.staging.to.matrix.I4.I32768()
// INT4-IR-NOT: llvm.aie4.insert.staging
// INT4-IR-COUNT-4: call <64 x i32> @llvm.aie4.I512.ACC2048.mmac({{.*}}, i32 769)
// INT4-IR-NOT: llvm.aie4.{{.*}}mmac
// INT4-IR: ret void
// INT4-ASM-LABEL: <main>:
// INT4-ASM-DAG: movx{{[[:blank:]]+}}crintmmode, #0x1
// INT4-ASM-DAG: vmov{{[[:blank:]]+}}za[i{{[0-9]+}}], y{{[0-9]+}}
// INT4-ASM-DAG: vmov{{[[:blank:]]+}}i4_zb, i4_za{{[[:blank:]]*(;|$)}}
// INT4-ASM-DAG: mmac.i{{[[:blank:]]+}}dm{{[ab][0-9]+}}, dm{{[ab][0-9]+}}, x{{[0-9]+}}, zb, r{{[0-9]+}}

// fp8 restages B0 for R3. That needs aiecc's -disable-machine-cse workaround
// for the Peano MachineCSE miscompile (aie4-mmac-fp8-cse-guard.mlir).
// FP8-IR-LABEL: define void @core_0_2(
// FP8-IR-COUNT-32: call void @llvm.aie4.insert.staging.fp8.I1024(
// FP8-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// FP8-IR: call void @llvm.aie4.staging.to.matrix.FP32768()
// FP8-IR-NOT: llvm.aie4.insert.staging
// FP8-IR-COUNT-4: call <64 x float> @llvm.aie4.fp8.I512.ACC2048.mmac({{.*}}, i32 0)
// FP8-IR-NOT: llvm.aie4.{{.*}}mmac
// FP8-IR-COUNT-32: call void @llvm.aie4.insert.staging.fp8.I1024(
// FP8-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// FP8-IR: call void @llvm.aie4.staging.to.matrix.FP32768()
// FP8-IR-NOT: llvm.aie4.insert.staging
// FP8-IR-COUNT-4: call <64 x float> @llvm.aie4.fp8.I512.ACC2048.mmac({{.*}}, i32 0)
// FP8-IR-NOT: llvm.aie4.{{.*}}mmac
// FP8-IR-COUNT-32: call void @llvm.aie4.insert.staging.fp8.I1024(
// FP8-IR-NOT: {{llvm.aie4.*(mmac|staging)}}
// FP8-IR: call void @llvm.aie4.staging.to.matrix.FP32768()
// FP8-IR-NOT: llvm.aie4.insert.staging
// FP8-IR-COUNT-4: call <64 x float> @llvm.aie4.fp8.I512.ACC2048.mmac({{.*}}, i32 1)
// FP8-IR-NOT: llvm.aie4.{{.*}}mmac
// FP8-IR: ret void
// FP8-ASM-LABEL: <main>:
// FP8-ASM-DAG: vmov{{[[:blank:]]+}}f_za[i{{[0-9]+}}], y{{[0-9]+}}
// FP8-ASM-DAG: vmov{{[[:blank:]]+}}f_zb, f_za{{[[:blank:]]*(;|$)}}
// FP8-ASM-DAG: mmac.f{{[[:blank:]]+}}dm{{[ab][0-9]+}}, dm{{[ab][0-9]+}}, x{{[0-9]+}}, f_zb, r{{[0-9]+}}
