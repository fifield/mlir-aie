#
# Exercise every supported trace location through IRON generation and placement.
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 2 -c 0 | aie-opt --aie-place-tiles | FileCheck %s -DROW=2 -DCOL=0
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 2 -c 1 | aie-opt --aie-place-tiles | FileCheck %s -DROW=2 -DCOL=1
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 2 -c 2 | aie-opt --aie-place-tiles | FileCheck %s -DROW=2 -DCOL=2
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 3 -c 0 | aie-opt --aie-place-tiles | FileCheck %s -DROW=3 -DCOL=0
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 3 -c 1 | aie-opt --aie-place-tiles | FileCheck %s -DROW=3 -DCOL=1
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 3 -c 2 | aie-opt --aie-place-tiles | FileCheck %s -DROW=3 -DCOL=2
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 4 -c 0 | aie-opt --aie-place-tiles | FileCheck %s -DROW=4 -DCOL=0
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 4 -c 1 | aie-opt --aie-place-tiles | FileCheck %s -DROW=4 -DCOL=1
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 4 -c 2 | aie-opt --aie-place-tiles | FileCheck %s -DROW=4 -DCOL=2
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 5 -c 0 | aie-opt --aie-place-tiles | FileCheck %s -DROW=5 -DCOL=0
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 5 -c 1 | aie-opt --aie-place-tiles | FileCheck %s -DROW=5 -DCOL=1
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -r 5 -c 2 | aie-opt --aie-place-tiles | FileCheck %s -DROW=5 -DCOL=2
#
# The file-output CLI must produce the same module as stdout.
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py > %t.stdout.mlir
# RUN: %python %S/../../programming_examples/aie4/vadd_trace_route_test/gen_vadd_trace.py -o %t.file.mlir
# RUN: diff %t.stdout.mlir %t.file.mlir
# RUN: aie-opt --pass-pipeline="builtin.module(aie.device(aie-place-tiles,aie-objectFifo-stateful-transform,aie-insert-trace-flows,aie-create-pathfinder-flows))" %t.file.mlir -o /dev/null
#
# CHECK: aie.device(npu3)
# CHECK-DAG: %[[SHIM:.*]] = aie.tile([[COL]], 0)
# CHECK-DAG: %[[MEM:.*]] = aie.tile([[COL]], 1)
# CHECK-DAG: %[[CORE:.*]] = aie.tile([[COL]], [[ROW]])
# CHECK-DAG: aie.objectfifo @inA_s[[COL]](%[[SHIM]], {%[[MEM]]}, 2 : i32) : !aie.objectfifo<memref<4096xi32>>
# CHECK-DAG: aie.objectfifo @inB_s[[COL]](%[[SHIM]], {%[[MEM]]}, 2 : i32) : !aie.objectfifo<memref<4096xi32>>
# CHECK-DAG: aie.objectfifo @outC_s[[COL]](%[[MEM]], {%[[SHIM]]}, 2 : i32) : !aie.objectfifo<memref<4096xi32>>
# CHECK-DAG: aie.objectfifo @inA_m[[COL]](%[[MEM]], {%[[CORE]]}, 2 : i32) : !aie.objectfifo<memref<1024xi32>>
# CHECK-DAG: aie.objectfifo @inB_m[[COL]](%[[MEM]], {%[[CORE]]}, 2 : i32) : !aie.objectfifo<memref<1024xi32>>
# CHECK-DAG: aie.objectfifo @outC_m[[COL]](%[[CORE]], {%[[MEM]]}, 2 : i32) : !aie.objectfifo<memref<1024xi32>>
# CHECK: aie.core(%[[CORE]])
# CHECK: arith.addi
# CHECK: aie.trace @trace_core_1(%[[CORE]])
# CHECK-NEXT: aie.trace.mode "Event-Time"
# CHECK-NEXT: aie.trace.packet type = core
# CHECK-NEXT: aie.trace.event <"INSTR_EVENT_0">
# CHECK-NEXT: aie.trace.event <"INSTR_EVENT_1">
# CHECK-NEXT: aie.trace.event <"INSTR_VECTOR">
# CHECK-NEXT: aie.trace.event <"MEMORY_STALL">
# CHECK-NEXT: aie.trace.event <"STREAM_STALL">
# CHECK-NEXT: aie.trace.event <"LOCK_STALL">
# CHECK-NEXT: aie.trace.event <"DMA_S2MM_0_RUNNING">
# CHECK-NEXT: aie.trace.event <"DMA_MM2S_0_RUNNING">
# CHECK-NEXT: aie.trace.start broadcast = 3
# CHECK-NEXT: aie.trace.stop broadcast = 4
# CHECK: aie.runtime_sequence(%[[A:.*]]: memref<12288xi32>, %[[B:.*]]: memref<12288xi32>, %[[C:.*]]: memref<12288xi32>)
# CHECK-NEXT: aie.trace.host_config {buffer_size = 8192 : i32}
# CHECK-NEXT: aie.trace.start_config @trace_core_1
# CHECK: aie.dma_bd(%[[A]] : memref<12288xi32> offset = 0 len = 4096
# CHECK: aie.dma_bd(%[[B]] : memref<12288xi32> offset = 0 len = 4096
# CHECK: aie.dma_bd(%[[C]] : memref<12288xi32> offset = 0 len = 4096
# CHECK: aie.dma_bd(%[[A]] : memref<12288xi32> offset = 4096 len = 4096
# CHECK: aie.dma_bd(%[[B]] : memref<12288xi32> offset = 4096 len = 4096
# CHECK: aie.dma_bd(%[[C]] : memref<12288xi32> offset = 4096 len = 4096
# CHECK: aie.dma_bd(%[[A]] : memref<12288xi32> offset = 8192 len = 4096
# CHECK: aie.dma_bd(%[[B]] : memref<12288xi32> offset = 8192 len = 4096
# CHECK: aie.dma_bd(%[[C]] : memref<12288xi32> offset = 8192 len = 4096
# CHECK-COUNT-9: aiex.dma_await_task
