[submodule "platforms/boards"]
	path = platforms/boards
	url = https://github.com/Xilinx/XilinxBoardStore.git
[submodule "cmake/modulesXilinx"]
	path = cmake/modulesXilinx
	url = https://github.com/fifield/cmakeModules.git
[submodule "runtime_lib/xaiengine/aie-rt"]
	path = third_party/aie-rt
	url = https://gitenterprise.xilinx.com/jefff/aie-rt.git
	branch = phoenix_v2023.2
[submodule "third_party/bootgen"]
	path = third_party/bootgen
	url = https://github.com/Xilinx/bootgen.git
	ignore = dirty
[submodule "third_party/aie_api"]
	path = third_party/aie_api
	url = https://gitenterprise.xilinx.com/jefff/aie_api.git
[submodule "third_party/hrx-xclbinutil"]
	path = third_party/hrx-xclbinutil
	url = https://github.com/jtuyls/hrx-xclbinutil.git
[submodule "third_party/cert"]
	path = third_party/cert
	url = https://gitenterprise.xilinx.com/TurinAI/cert.git
[submodule "third_party/aiebu"]
	path = third_party/aiebu
	url = https://github.com/Xilinx/aiebu.git
