//
// MDV6 32-core full-model end-to-end test. Builds all merged ELFs required
// by test_full_model_mc.py into lit's per-test working directory (never the
// source tree), then runs one forward pass on NPU2 and gates on PASS (max
// class/vector diff within tolerance).
//
// mdv6_weights is set in lit.local.cfg when mdv6_bf16_weights.pt is staged
// next to the test; without trained weights the model emits NaN under
// random init.
//
// All NPU dispatches go through merged ELFs (Phases A.1, C, E, F, G); the
// legacy xclbin path has been removed. ELFs are built into
// MDV6_BUILD_DIR/build_merged/ which run_tiled_mc.py loads from.
//
// REQUIRES: ryzen_ai_npu2, peano, torch, mdv6_weights
//
// RUN: rm -rf test_stx
// RUN: mkdir -p test_stx
// RUN: cd test_stx
//
// Build the merged ELFs. Order matters only for caching: x1 builds first
// produce the per-shape sub-MLIRs that pair/ocb wrappers reuse.
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_x1_mc.py
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_x1_gemm.py
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_pair_rn1.py
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_ocb.py --layer all
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/test_full_model_mc.py
