//
// MDV6 full-model end-to-end through the packed-GEMM spatial-fanout
// dispatch path (MDV6_USE_PACKED_GEMM=1). Mirrors run_full_model.lit
// except:
//   1. conv/build_packed_gemm.py builds the packed ELFs first.
//   2. MDV6_USE_PACKED_GEMM=1 routes every multi-batch GEMM dispatch
//      through the packed `[wt, packed_in, packed_out]` ABI instead of
//      the per-batch arg-pair x1 path.
//
// PASS gate is the same as run_full_model.lit: max class/vector diff
// within tolerance. test_full_model_mc.py exits non-zero on FAIL.
//
// REQUIRES: ryzen_ai_npu2, peano, torch, mdv6_weights
//
// RUN: rm -rf test_stx
// RUN: mkdir -p test_stx
// RUN: cd test_stx
//
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_x1_mc.py
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_x1_gemm.py
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_pair_rn1.py
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_ocb.py --layer all
// RUN: env MDV6_BUILD_DIR=. %run_on_npu2% python3 %S/conv/build_packed_gemm.py
// RUN: env MDV6_BUILD_DIR=. MDV6_USE_PACKED_GEMM=1 %run_on_npu2% python3 %S/test_full_model_mc.py
