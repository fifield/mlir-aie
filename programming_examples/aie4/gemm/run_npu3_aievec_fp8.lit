// GEMM fp8 with the flat AIEVec core (KERNEL=aievec). Float types produce fp32
// output: there is no f32 narrowing op in AIEVec.
// One dtype per test, for CI's per-test time limit.
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: mkdir -p test_npu3_aievec_fp8
// RUN: cd test_npu3_aievec_fp8
// RUN: make -f %S/Makefile test.exe
// RUN: make -f %S/Makefile all KERNEL=aievec DTYPE=fp8 M=512 N=768 CT=1
// RUN: %run_on_npu3% make -f %S/Makefile run KERNEL=aievec DTYPE=fp8 M=512 N=768 CT=1 | FileCheck %s
// CHECK: PASS
