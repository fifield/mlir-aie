// GEMM uint8 to uint8. Each input/output pair has its own test timeout and build
// directory: compiling all designs in one test exceeds CI's per-test time limit.
// At K=1024, SHIFT=17 keeps the reference varied; SHIFT=12 saturates it to 255.
// REQUIRES: ryzen_ai_npu3, chess
//
// RUN: mkdir -p test_npu3_u8
// RUN: cd test_npu3_u8
// RUN: make -f %S/Makefile clean
// RUN: env AIECC_JOBS=2 make -f %S/Makefile all DTYPE=u8 M=512 N=768 K=1024 SHIFT=17
// RUN: %run_on_npu3% make -f %S/Makefile run DTYPE=u8 M=512 N=768 K=1024 SHIFT=17 | FileCheck %s
// CHECK: PASS
