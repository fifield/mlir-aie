// GEMM uint8 x int8 to int8. Each input/output pair has its own test timeout and build
// directory: compiling all designs in one test exceeds CI's per-test time limit.
// REQUIRES: ryzen_ai_npu3, chess
//
// RUN: mkdir -p test_npu3_u8i8
// RUN: cd test_npu3_u8i8
// RUN: make -f %S/Makefile clean
// RUN: env AIECC_JOBS=2 make -f %S/Makefile all DTYPE=u8i8 M=512 N=768
// RUN: %run_on_npu3% make -f %S/Makefile run DTYPE=u8i8 M=512 N=768 | FileCheck %s
// CHECK: PASS
