// GEMM fp8 to f32. Each input/output pair has its own test timeout and build
// directory: compiling all five designs exceeds CI's per-test time limit.
// REQUIRES: ryzen_ai_npu3, chess
//
// RUN: mkdir -p test_npu3_fp8_f32
// RUN: cd test_npu3_fp8_f32
// RUN: make -f %S/Makefile clean
// RUN: env AIECC_JOBS=2 make -f %S/Makefile all DTYPE=fp8 OUT=f32 M=512 N=768 K=1024
// RUN: %run_on_npu3% make -f %S/Makefile run DTYPE=fp8 OUT=f32 M=512 N=768 K=1024 | FileCheck %s
// CHECK: PASS
