// GEMM uint8 to int32 checks the full accumulations without narrowing.
// Each input/output pair has its own test timeout and build directory.
// REQUIRES: ryzen_ai_npu3, chess
//
// RUN: mkdir -p test_npu3_u8_i32
// RUN: cd test_npu3_u8_i32
// RUN: make -f %S/Makefile clean
// RUN: env AIECC_JOBS=2 make -f %S/Makefile all DTYPE=u8 OUT=i32 M=512 N=768 K=1024
// RUN: %run_on_npu3% make -f %S/Makefile run DTYPE=u8 OUT=i32 M=512 N=768 K=1024 | FileCheck %s
// CHECK: PASS
