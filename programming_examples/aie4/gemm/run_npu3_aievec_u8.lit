// GEMM uint8 with the flat AIEVec core (KERNEL=aievec).
// One dtype per test, for CI's per-test time limit.
// REQUIRES: ryzen_ai_npu3, peano
//
// RUN: mkdir -p test_npu3_aievec_u8
// RUN: cd test_npu3_aievec_u8
// RUN: make -f %S/Makefile test.exe
// RUN: make -f %S/Makefile all KERNEL=aievec DTYPE=u8 M=512 N=768
// RUN: %run_on_npu3% make -f %S/Makefile run KERNEL=aievec DTYPE=u8 M=512 N=768 | FileCheck %s
// CHECK: PASS
