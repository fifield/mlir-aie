//
// REQUIRES: ryzen_ai_npu3, chess
//
// Lightweight smoke-test config (1 channel, 1 MiB, 1 iteration) rather than
// the default 12-channel/16MiB/8-iteration bandwidth sweep, which is a
// benchmark, not a correctness check.
//
// RUN: mkdir -p test_npu3
// RUN: cd test_npu3
// RUN: make -f %S/Makefile clean CHANNELS=1 BYTES_PER_CHANNEL=1MiB ITERATIONS=1
// RUN: make -f %S/Makefile all CHANNELS=1 BYTES_PER_CHANNEL=1MiB ITERATIONS=1
// RUN: %run_on_npu3% make -f %S/Makefile run CHANNELS=1 BYTES_PER_CHANNEL=1MiB ITERATIONS=1
