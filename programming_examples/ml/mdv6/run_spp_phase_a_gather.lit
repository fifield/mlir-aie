// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Sixteen numerical projection/pool workers feed resident gather in one run.
// Exact production KB128 f0 plus independent pooling/gather; not full SPP.
// The integrated route is currently compile-blocked by mlir-aie-8cu.
// No lit config enables this feature. Enable only after routing/resource review;
// do not silently substitute an old diagnostic xclbin for this numerical cut.
// REQUIRES: mdv6_phase_a_gather_routing
// REQUIRES: ryzen_ai_npu2, peano, torch, mdv6_weights
// RUN: mkdir -p %t.dir
// RUN: make -C %t.dir -f %S/sppelan/Makefile.phase_a_gather
// RUN: python3 -O %S/sppelan/check_phase_a_gather_ir.py --build-dir %t.dir
// RUN: env MDV6_BUILD_DIR=%t.dir python3 %S/gemm_conv1x1/build_gemm_conv1x1.py gemm_t28_ic256_oc128_kb128_p1
// RUN: %run_on_npu2% python3 -O %S/sppelan/test_phase_a_gather.py --build-dir %t.dir --baseline-dir %t.dir --frames 30 --failure-dir %t.dir/failures
