// One full-frame stream through 25 bounded, receive-gated packet stripe joins.
// REQUIRES: ryzen_ai_npu2, peano, torch
// RUN: mkdir -p %t.dir
// RUN: make -C %t.dir -f %S/sppelan/Makefile.packet_stripe_join
// RUN: python3 -O %S/sppelan/check_packet_stripe_join_ir.py --build-dir %t.dir
// RUN: %run_on_npu2% python3 -O %S/sppelan/test_packet_stripe_join.py --build-dir %t.dir --frames 30 --failure-dir %t.dir/failures
