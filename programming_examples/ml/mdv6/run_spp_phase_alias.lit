// One explicit L1 arena, finite A/25B phases, and safe consecutive-frame rearm.
// Opaque-bit ownership diagnostic, not numerical SPP or a full-island barrier.
// REQUIRES: ryzen_ai_npu2, peano, torch
// RUN: mkdir -p %t.dir
// RUN: make -C %t.dir -f %S/sppelan/Makefile.phase_alias
// RUN: python3 -O %S/sppelan/check_phase_alias_ir.py --build-dir %t.dir
// RUN: %run_on_npu2% python3 -O %S/sppelan/test_phase_alias.py --build-dir %t.dir --frames 30 --failure-dir %t.dir/failures
