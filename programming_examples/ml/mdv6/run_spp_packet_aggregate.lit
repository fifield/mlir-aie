// Four worker outputs packet-merge into one memtile receive channel.
// Reverse input delivery, forward grants/output order; exact opaque-bit tags.
// REQUIRES: ryzen_ai_npu2, peano, torch
// RUN: mkdir -p %t.dir
// RUN: make -C %t.dir -f %S/sppelan/Makefile.packet_aggregate
// RUN: python3 -O %S/sppelan/check_packet_aggregate_ir.py --build-dir %t.dir
// RUN: %run_on_npu2% python3 -O %S/sppelan/test_packet_aggregate.py --build-dir %t.dir --frames 30 --failure-dir %t.dir/failures
