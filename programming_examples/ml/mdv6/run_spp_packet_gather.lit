// Resident four-column packet aggregation feeds gather without host staging.
// Diagnostic opaque-bit transport, not numerical SPP or a production route.
// REQUIRES: ryzen_ai_npu2, peano, torch
// RUN: mkdir -p %t.dir
// RUN: make -C %t.dir -f %S/sppelan/Makefile.packet_gather
// RUN: python3 -O %S/sppelan/check_packet_gather_ir.py --build-dir %t.dir
// RUN: %run_on_npu2% python3 -O %S/sppelan/test_packet_gather.py --build-dir %t.dir --frames 30 --failure-dir %t.dir/failures
